#!/bin/sh
#
# Arbigent wrapper.
#
# Downloads the arbigent CLI distribution declared in arbigentw.properties next to this
# script, verifies its SHA-256 checksum and runs it. Regenerate this file and its
# properties with:
#
#   arbigent wrapper --version <version>
#
# Without an installed arbigent, run this script once with ARBIGENT_VERSION set to pin
# that release, then commit the properties file it writes.
#
set -eu

APP_NAME=arbigentw

die() {
  echo "$APP_NAME: $*" >&2
  exit 1
}

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)
# The properties file lives beside the script, whichever directory the script is invoked
# from. The current directory is left alone, so project settings are still read from it.
PROPERTIES_FILE="$SCRIPT_DIR/arbigentw.properties"
# Where arbigent 0.81.0 wrote the properties. That file is not read any more.
LEGACY_PROPERTIES_FILE="$SCRIPT_DIR/.arbigent/wrapper/arbigent-wrapper.properties"

read_property() {
  sed -n "s/^[[:space:]]*$1[[:space:]]*=[[:space:]]*//p" "$PROPERTIES_FILE" | tr -d '\r' | tail -n 1
}

# A stalled transfer must not hang a CI job forever. The limit is on throughput rather than on
# total time because the distribution is large and a slow link is not a failure.
CURL_TIMEOUTS="--connect-timeout 30 --speed-limit 1024 --speed-time 60"

download() {
  if command -v curl >/dev/null 2>&1; then
    # Keep the progress meter interactive only, so CI logs stay readable.
    if [ -t 2 ]; then
      curl -fL --retry 3 $CURL_TIMEOUTS -o "$2" "$1"
    else
      curl -sSfL --retry 3 $CURL_TIMEOUTS -o "$2" "$1"
    fi
  elif command -v wget >/dev/null 2>&1; then
    wget -q --timeout=30 --tries=3 -O "$2" "$1"
  else
    die "neither curl nor wget is available to download $1"
  fi
}

download_checksum() {
  # The digest is the only thing that says which bytes may be installed, so an attacker who can
  # rewrite it can replace the whole distribution: it is read over HTTPS only, and curl is told to
  # refuse a redirect that leaves HTTPS. Plain HTTP is accepted against the loopback interface,
  # where there is nothing in between.
  # --proto-redir applies to redirects only, so it is passed whatever the first hop is.
  proto_args="--proto-redir =https"
  case "$1" in
    https://*) proto_args="--proto =https $proto_args" ;;
    http://127.0.0.1[:/]*|http://localhost[:/]*|http://\[::1\][:/]*) ;;
    *) die "refusing to read $1 over an unencrypted connection. Pin the release with
'arbigent wrapper --version <version>' instead." ;;
  esac
  if ! command -v curl >/dev/null 2>&1; then
    # wget cannot be told to refuse a redirect from HTTPS to HTTP (--https-only only applies to
    # recursive downloads), and a digest read over such a redirect would verify an attacker's
    # archive just as happily as the real one.
    die "curl is required to pin a release. Install curl, or generate
arbigentw.properties with 'arbigent wrapper --version <version>'."
  fi
  curl -sSfL --retry 3 $CURL_TIMEOUTS $proto_args -o "$2" "$1"
}

bootstrap_properties() {
  # Bootstrapping without an installed arbigent: ARBIGENT_VERSION names the release to pin,
  # and the checksum comes from the '.sha256' file GitHub publishes beside the archive.
  version=$1
  base_url=${ARBIGENT_RELEASE_BASE_URL:-https://github.com/takahirom/arbigent/releases/download}
  url="$base_url/$version/arbigent-$version.tar.gz"
  checksum_file=$(mktemp)
  echo "$APP_NAME: pinning arbigent $version" >&2
  download_checksum "$url.sha256" "$checksum_file" || {
    rm -f "$checksum_file"
    die "cannot read $url.sha256. Check that arbigent $version has been released."
  }
  checksum=$(tr -d '\r\n' < "$checksum_file" | cut -d' ' -f1)
  rm -f "$checksum_file"
  properties_dir=$(dirname "$PROPERTIES_FILE")
  mkdir -p "$properties_dir"
  # Write through a temp file in the same directory so an interrupted or failing write never
  # leaves a half-written properties file that a later run would read as a valid pin.
  properties_tmp=$(mktemp "$properties_dir/.arbigentw.properties.XXXXXX")
  {
    echo "distributionVersion=$version"
    echo "distributionUrl=$url"
    echo "distributionSha256Sum=$checksum"
  } > "$properties_tmp" || {
    rm -f "$properties_tmp"
    die "cannot write $PROPERTIES_FILE"
  }
  mv "$properties_tmp" "$PROPERTIES_FILE" || {
    rm -f "$properties_tmp"
    die "cannot write $PROPERTIES_FILE"
  }
  echo "$APP_NAME: wrote $PROPERTIES_FILE. Commit it together with this script." >&2
}

if [ ! -f "$PROPERTIES_FILE" ]; then
  # Checked before the ARBIGENT_VERSION bootstrap, so a CI job that still exports the variable
  # does not quietly pin a second release beside the one the repository already carries.
  if [ -e "$LEGACY_PROPERTIES_FILE" ]; then
    die "the wrapper properties moved from .arbigent/wrapper/arbigent-wrapper.properties to
arbigentw.properties next to this script in arbigent 0.81.1. Move the file:
  git mv .arbigent/wrapper/arbigent-wrapper.properties arbigentw.properties
or regenerate both files with 'arbigent wrapper --version <version>'."
  fi
  if [ -n "${ARBIGENT_VERSION:-}" ]; then
    bootstrap_properties "$ARBIGENT_VERSION"
  else
    die "cannot read $PROPERTIES_FILE.
Create it with 'arbigent wrapper --version <version>', or run this script once with
ARBIGENT_VERSION=<version> to pin that release without installing arbigent first."
  fi
fi

DISTRIBUTION_VERSION=$(read_property distributionVersion)
DISTRIBUTION_URL=$(read_property distributionUrl)
DISTRIBUTION_SHA256=$(read_property distributionSha256Sum)

[ -n "$DISTRIBUTION_URL" ] || die "distributionUrl is not set in $PROPERTIES_FILE"
[ -n "$DISTRIBUTION_SHA256" ] || die "distributionSha256Sum is not set in $PROPERTIES_FILE. The wrapper refuses to install an unverified distribution."
case "$DISTRIBUTION_SHA256" in
  *[!0-9a-f]*) die "distributionSha256Sum is not a lowercase hex SHA-256 digest: $DISTRIBUTION_SHA256" ;;
esac
[ ${#DISTRIBUTION_SHA256} -eq 64 ] || die "distributionSha256Sum must be 64 hex characters, got ${#DISTRIBUTION_SHA256}"

ARBIGENT_USER_HOME=${ARBIGENT_USER_HOME:-"$HOME/.arbigent"}
ARCHIVE_NAME=$(basename "$DISTRIBUTION_URL")
DIST_NAME=${ARCHIVE_NAME%.tar.gz}

# distributionVersion is metadata for people and update bots; the URL and the checksum decide
# what runs. A bot that bumps only the version would otherwise keep running the old release
# while the file claims the new one, so the two are required to agree whenever the archive
# follows the release naming. Mirrors with other archive names are not checked.
if [ -n "$DISTRIBUTION_VERSION" ]; then
  case "$ARCHIVE_NAME" in
    arbigent-*.tar.gz)
      [ "$ARCHIVE_NAME" = "arbigent-$DISTRIBUTION_VERSION.tar.gz" ] || die "distributionVersion is $DISTRIBUTION_VERSION but distributionUrl points at $ARCHIVE_NAME.
Update the URL and the checksum together with 'arbigentw wrapper --version $DISTRIBUTION_VERSION'." ;;
  esac
fi
# The whole digest names the directory: a prefix would let two distributions that share it share
# an install, and the digest is the only thing that says which bytes were verified.
INSTALL_DIR="$ARBIGENT_USER_HOME/wrapper/dists/$DIST_NAME/$DISTRIBUTION_SHA256"

find_launcher() {
  for candidate in "$INSTALL_DIR"/*/bin/arbigent; do
    if [ -x "$candidate" ]; then
      echo "$candidate"
      return 0
    fi
  done
  return 1
}

require_java() {
  # A set but broken JAVA_HOME is a misconfiguration worth reporting, not something to work around
  # silently: falling back to the PATH java would run a different JDK than the one asked for.
  if [ -n "${JAVA_HOME:-}" ]; then
    [ -x "$JAVA_HOME/bin/java" ] || die "JAVA_HOME is set to an invalid directory: $JAVA_HOME
Set JAVA_HOME to the root of a Java 17 installation, or unset it to use the java on PATH."
    JAVACMD="$JAVA_HOME/bin/java"
  elif command -v java >/dev/null 2>&1; then
    JAVACMD=java
  else
    die "no Java found. Arbigent needs Java 17 or later. Install a JDK or set JAVA_HOME."
  fi
  java_version=$("$JAVACMD" -version 2>&1 | sed -n 's/.*version "\([0-9][0-9]*\).*/\1/p' | head -n 1)
  # A failing or unrecognisable 'java -version' leaves this empty. Letting that through would
  # only move the failure to a worse place: the launcher starting on a Java that cannot run it.
  [ -n "$java_version" ] || die "cannot determine the Java version from '$JAVACMD -version'.
Arbigent needs Java 17 or later. Set JAVA_HOME to a working JDK."
  if [ "$java_version" -lt 17 ]; then
    die "Java 17 or later is required, but $JAVACMD reports major version $java_version."
  fi
}

sha256_of() {
  if command -v sha256sum >/dev/null 2>&1; then
    sha256sum "$1" | cut -d' ' -f1
  elif command -v shasum >/dev/null 2>&1; then
    shasum -a 256 "$1" | cut -d' ' -f1
  elif command -v openssl >/dev/null 2>&1; then
    openssl dgst -sha256 "$1" | sed 's/.*= *//'
  else
    die "no SHA-256 tool found. Install sha256sum, shasum or openssl."
  fi
}

install_distribution() {
  command -v tar >/dev/null 2>&1 || die "tar is required to unpack $ARCHIVE_NAME"
  mkdir -p "$INSTALL_DIR"
  tmp_dir=$(mktemp -d "$INSTALL_DIR/.tmp.XXXXXX")
  trap 'rm -rf "$tmp_dir"' EXIT INT TERM
  archive="$tmp_dir/$ARCHIVE_NAME"

  echo "$APP_NAME: downloading $DISTRIBUTION_URL" >&2
  download "$DISTRIBUTION_URL" "$archive"

  actual=$(sha256_of "$archive")
  if [ "$actual" != "$DISTRIBUTION_SHA256" ]; then
    rm -rf "$tmp_dir"
    trap - EXIT INT TERM
    die "checksum mismatch for $DISTRIBUTION_URL
  expected $DISTRIBUTION_SHA256
  actual   $actual
The download was discarded."
  fi

  tar -xzf "$archive" -C "$tmp_dir"
  rm -f "$archive"

  # Publish each extracted top-level directory. A concurrent wrapper run may have
  # published the same directory first; in that case keep the one already there.
  for extracted in "$tmp_dir"/*/; do
    [ -d "$extracted" ] || continue
    target="$INSTALL_DIR/$(basename "$extracted")"
    [ -e "$target" ] || mv "$extracted" "$target" 2>/dev/null || true
  done

  rm -rf "$tmp_dir"
  trap - EXIT INT TERM
}

require_java

if ! LAUNCHER=$(find_launcher); then
  install_distribution
  LAUNCHER=$(find_launcher) || die "$DISTRIBUTION_URL does not contain bin/arbigent"
fi

exec "$LAUNCHER" "$@"
